generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  Student
  Teacher
  Admin
}

enum LessonStatus {
  Upcoming
  Confirmed
  Cancelled
  Completed
}

enum Subject {
  Mathematics
  Physics
  Chemistry
  Biology
  English_Literature @map("English Literature")
  Computer_Science   @map("Computer Science")
}

enum Level {
  GCSE
  A_LEVEL
}


model User {
  id                String    @id @default(uuid())
  email             String    @unique
  name              String?
  password          String?
  provider          String    @default("credentials")
  providerId        String?   @unique
  image             String?
  role              Role      @default(Student)
  passwordChangedAt DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  teacher Teacher?
  student Student?

  @@map("users")
}

model Teacher {
  id                    String   @id @default(uuid())
  userId                String   @unique
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bio                   String   @db.Text
  qualifications         String   @db.Text
  rating                Float    @default(5.0)
  hourlyRate            Decimal  @db.Decimal(10, 2)
  totalEarnings         Decimal  @default(0.00) @db.Decimal(10, 2)
  totalHours            Float    @default(0.0)

  // Teacher Preference Setting
  requireApproval       Boolean  @default(false) // false = Instant Booking, true = Request & Approve

  teaches               Teaches[]
  availabilities        Availability[]
  lessons               Lesson[]

  @@map("teachers")
}

model Teaches {
  id        String  @id @default(uuid())
  teacherId String
  teacher   Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  subject   Subject
  level     Level

  @@unique([teacherId, subject, level])
  @@map("teaches")
}

model Student {
  id       String    @id @default(uuid())
  userId   String    @unique
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  subjects StudentSubject[]
  lessons Lesson[]


  @@map("students")
}

model StudentSubject {
  id        String  @id @default(uuid())
  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  subject   Subject
  level     Level

  @@unique([studentId, subject, level])
  @@map("student_subjects")
}

model Availability {
  id        String   @id @default(uuid())
  teacherId String
  teacher   Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  startTime DateTime 
  endTime   DateTime 

  lessons   Lesson[]

  @@map("availabilities")
}

model Lesson {
  id             String        @id @default(uuid())
  teacherId      String
  teacher        Teacher       @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  studentId      String
  student        Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  availabilityId String
  availability   Availability  @relation(fields: [availabilityId], references: [id], onDelete: Cascade)

// Subject and Topic tracking
  subject        Subject
  topic          String?       @db.VarChar(255)

  // Workspace tracking
  meetingRoomId  String?       @db.Uuid

  // Time & Duration (duration in minutes replaces endTime)
  startTime      DateTime
  duration       Int           @default(60) // Store minutes as SmallInt/Int
  status         LessonStatus @default(Upcoming)

  notes          String?       @db.VarChar(255)
  createdAt      DateTime      @default(now())

  classroom      Classroom?

  @@index([studentId, startTime])
  @@index([teacherId, startTime])
  @@index([teacherId, startTime, status])
  @@map("lessons")
}

model Classroom {
  id        String  @id @default(uuid())
  lessonId String  @unique
  lesson   Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  meetingRoomId String  @unique
  isActive      Boolean @default(false)
  joinCode      String 

  teacherJoinedAt DateTime?
  studentJoinedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@map("classrooms")
}